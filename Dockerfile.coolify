# Dockerfile.coolify — single-image deployment for Coolify.
#
# Combines the Rust backend (dev-pulse) and the Vite SPA, served by
# Caddy on :8080. Coolify's Traefik edge terminates TLS in front of
# this image, same role fly-proxy plays for Dockerfile.fly.
#
# Build context is THIS REPO (Coolify Base Directory = dev-pulse/,
# one git clone — see COOLIFY-SCOPE.md §2.1). The Cargo path-deps and
# pnpm workspace expect a SIBLING `../starter` checkout, so we vendor
# `starter` as a git submodule at dev-pulse/starter/ and reshuffle it
# to /src/starter + /src/dev-pulse inside the image — recreating the
# exact layout Cargo.toml / pnpm-workspace.yaml already assume,
# without touching a single path reference.
#
# Differs from Dockerfile.fly in one structural way: NO bundled
# Postgres. Coolify provides Postgres as a first-class resource
# (backups, HA) — see COOLIFY-SCOPE.md §2.3. DATABASE_URL points at
# that resource instead.

# ============================================================ backend
FROM rust:1.90-slim-bookworm AS backend-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src/dev-pulse
RUN mv /src/dev-pulse/starter /src/starter

WORKDIR /src/dev-pulse
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/dev-pulse/target \
    cargo build -p dev-pulse --release \
 && cp target/release/dev-pulse /tmp/dev-pulse

# ============================================================ frontend
FROM node:22-slim AS frontend-builder

RUN npm install -g pnpm@9

WORKDIR /src
COPY . /src/dev-pulse
RUN mv /src/dev-pulse/starter /src/starter

WORKDIR /src/dev-pulse
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter dev-pulse-frontend build

# ============================================================ runtime
FROM debian:bookworm-slim AS runtime

# Runtime deps + Caddy (cloudsmith). No Postgres — Coolify supplies it
# as a managed resource (COOLIFY-SCOPE.md §2.3).
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libssl3 gettext-base tini debian-keyring \
      debian-archive-keyring apt-transport-https curl gnupg lsb-release \
 && curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
      | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg \
 && curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
      > /etc/apt/sources.list.d/caddy-stable.list \
 && apt-get update && apt-get install -y --no-install-recommends \
      caddy \
 && apt-get purge -y gnupg lsb-release \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# Backend binary.
COPY --from=backend-builder /tmp/dev-pulse /usr/local/bin/dev-pulse

# Authz policy file. The binary loads it via the hard-coded relative
# path `crates/dp-server/policy/dev-pulse.toml`, so we mirror that
# layout under /app and the entrypoint cds to /app before exec.
COPY crates/dp-server/policy/dev-pulse.toml \
     /app/crates/dp-server/policy/dev-pulse.toml

# SPA bundle.
COPY --from=frontend-builder /src/dev-pulse/frontend/dist \
                             /usr/share/dev-pulse/web

# Caddy config + config template + entrypoint.
COPY Caddyfile                                /etc/caddy/Caddyfile
COPY crates/dev-pulse/config.coolify.toml     /etc/dev-pulse/config.template.toml
COPY scripts/coolify-entrypoint.sh            /usr/local/bin/coolify-entrypoint.sh
RUN chmod +x /usr/local/bin/coolify-entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/coolify-entrypoint.sh"]
CMD ["serve"]
