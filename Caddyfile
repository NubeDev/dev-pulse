# Caddyfile — runs INSIDE the Fly Machine on :8080.
#
# Fly's edge (Anycast + Let's Encrypt) terminates TLS for *.fly.dev
# and custom domains, then forwards plain HTTP to this listener.
# That's why we bind plain `:8080` and not `https://`. The local
# HTTPS pre-flight (docker-compose.fly-local.yml) puts a SECOND Caddy
# in front with `tls /certs/localhost.pem` to mimic Fly's edge.

{
	# Trust fly-proxy / the local TLS Caddy so X-Forwarded-* are
	# honoured (drives Secure-cookie issuance, scheme-aware redirects).
	servers {
		trusted_proxies static private_ranges
	}
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# Long-cache hashed assets (matches the file_server hit below).
	@hashed path_regexp \.[0-9a-f]{8,}\.(js|css|woff2?|png|jpg|svg|webp|avif)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# SPA shell + static assets. The frontend uses HASH routing
	# (URLs like /#/account/settings), so the path the server ever
	# sees is `/`, `/index.html`, `/assets/*`, or a top-level static
	# file. Everything else is API and goes to the backend.
	@spa {
		path / /index.html /favicon.ico /robots.txt /manifest.json
		path /assets/* /static/* /icons/*
	}
	handle @spa {
		root * /usr/share/dev-pulse/web
		try_files {path} /index.html
		file_server
	}

	# Catch-all: anything that isn't the SPA is the API.
	handle {
		reverse_proxy 127.0.0.1:8731
	}

	log {
		output stdout
		format console
	}
}
