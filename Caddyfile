# Caddyfile — runs inside the Fly Machine on :8080.
#
# Fly's edge (Anycast + Let's Encrypt) terminates TLS for *.fly.dev
# and custom domains, then forwards plain HTTP to this listener.
# That's why we bind plain `:8080` and not `https://`. If you ever
# run this image OFF Fly, swap `:8080` for your hostname and Caddy
# will provision certs automatically.

{
	# Trust Fly's edge so $remote_addr/X-Forwarded-* are honored.
	servers {
		trusted_proxies static private_ranges
	}
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# API routes — must match frontend/nginx.conf and frontend/vite.config.ts.
	@api {
		path /auth/* /reports/* /directory/* /admin/* /health /openapi.json /metrics
	}
	reverse_proxy @api 127.0.0.1:8731 {
		header_up X-Forwarded-Proto {http.request.header.X-Forwarded-Proto}
		header_up X-Forwarded-For   {http.request.header.X-Forwarded-For}
		header_up Host              {http.request.host}
	}

	# SPA: serve dist/, fall back to index.html for client-side routing.
	root * /usr/share/dev-pulse/web
	try_files {path} /index.html
	file_server

	# Long-cache hashed assets, no-cache the entry HTML.
	@hashed path_regexp \.[0-9a-f]{8,}\.(js|css|woff2?|png|jpg|svg|webp|avif)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	log {
		output stdout
		format console
	}
}
