# Dockerfile.fly — single-image deployment for Fly.io.
#
# Combines the Rust backend (dev-pulse) and the Vite SPA, served by
# Caddy on :8080. Fly's edge terminates TLS in front of this image.
#
# Build context MUST be the PARENT directory containing both
# `dev-pulse/` and `starter/` (workspace path-deps). Use
# `make fly-deploy`, which sets the context for you.

# ============================================================ backend
FROM rust:1.90-slim-bookworm AS backend-builder

RUN apt-get update && apt-get install -y --no-install-recommends \
      pkg-config libssl-dev ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY starter   /src/starter
COPY dev-pulse /src/dev-pulse

WORKDIR /src/dev-pulse
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/src/dev-pulse/target \
    cargo build -p dev-pulse --release \
 && cp target/release/dev-pulse /tmp/dev-pulse

# ============================================================ frontend
FROM node:22-slim AS frontend-builder

RUN npm install -g pnpm@9

WORKDIR /src
COPY starter   /src/starter
COPY dev-pulse /src/dev-pulse

WORKDIR /src/dev-pulse
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter dev-pulse-frontend build

# ============================================================ runtime
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates libssl3 gettext-base tini debian-keyring \
      debian-archive-keyring apt-transport-https curl gnupg \
 && curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/gpg.key' \
      | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg \
 && curl -1sLf 'https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt' \
      > /etc/apt/sources.list.d/caddy-stable.list \
 && apt-get update && apt-get install -y --no-install-recommends caddy \
 && apt-get purge -y curl gnupg \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# Backend binary.
COPY --from=backend-builder /tmp/dev-pulse /usr/local/bin/dev-pulse

# Authz policy file. The binary loads it via the hard-coded relative
# path `crates/dp-server/policy/dev-pulse.toml`, so we mirror that
# layout under /app and the entrypoint cds to /app before exec.
COPY dev-pulse/crates/dp-server/policy/dev-pulse.toml \
     /app/crates/dp-server/policy/dev-pulse.toml

# SPA bundle.
COPY --from=frontend-builder /src/dev-pulse/frontend/dist \
                             /usr/share/dev-pulse/web

# Caddy config + config template + entrypoint.
COPY dev-pulse/Caddyfile                          /etc/caddy/Caddyfile
COPY dev-pulse/crates/dev-pulse/config.fly.toml   /etc/dev-pulse/config.template.toml
COPY dev-pulse/scripts/fly-entrypoint.sh          /usr/local/bin/fly-entrypoint.sh
RUN chmod +x /usr/local/bin/fly-entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/fly-entrypoint.sh"]
CMD ["serve"]
