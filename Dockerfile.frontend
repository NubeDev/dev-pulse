# Frontend image for dev-pulse — builds the Vite SPA, serves it via nginx.
#
# Build context MUST be the PARENT directory containing both
# `dev-pulse/` and `starter/` (pnpm-workspace.yaml references
# `../starter/packages/*`). See Dockerfile.backend for rationale.

FROM node:22-slim AS builder

RUN npm install -g pnpm@9

WORKDIR /src
COPY starter   /src/starter
COPY dev-pulse /src/dev-pulse

WORKDIR /src/dev-pulse
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter dev-pulse-frontend build

# ---------------------------------------------------------------- runtime

FROM nginx:alpine

COPY --from=builder /src/dev-pulse/frontend/dist /usr/share/nginx/html
COPY dev-pulse/frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
