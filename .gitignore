/target
Cargo.lock.bak
*.swp
.DS_Store
*.db
*.pid

# Local secrets — `secret://NAME` handles in config.toml resolve to
# env vars; `.env` is the conventional way to seed them. See
# .env.example for the keys; real values never go in git.
.env
.env.local

# Makefile runtime — PID files, logs, and the local config copy.
.run
config.local.toml

# frontend (Vite + pnpm). Ignore node_modules only — keep dist out of
# git too via Vite's own outDir; we serve it from the Rust binary at
# build time, not from version control.
frontend/node_modules
node_modules

# Frontend build + Playwright e2e artefacts (stage 11).
frontend/dist
frontend/test-results
frontend/playwright-report
frontend/.playwright
auth.db-shm
auth.db-wal
tty sane
.env 
