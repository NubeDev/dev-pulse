{
  "name": "dev-pulse-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "dev-pulse operator UI. Vite + React + TS + Tailwind v4, consuming @nube/starter-client-ts (REST), @nube/starter-ui-core (auth + react-query), @nube/starter-ui-kit (shadcn primitives).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@nube/starter-client-ts": "workspace:*",
    "@nube/starter-ui-core": "workspace:*",
    "@nube/starter-ui-kit": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0"
  }
}
